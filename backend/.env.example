# CASEYA Plant Backend Environment Configuration
ENVIRONMENT=production
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://*.vercel.app

# Google Sheets Data Store Configuration (Optional - backend will fall back to local JSON store if empty)
GOOGLE_SHEETS_SPREADSHEET_ID=your_plant_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json

# Plant Configuration
BOILER_CALIBRATION_MULTIPLIER=900.0
BOILER_CALIBRATION_DIVISOR=70.0
FORMULA_VERSION=v1.2-Standard-2026
