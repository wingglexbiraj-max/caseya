{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "caseya (Chrome)",
            "request": "launch",
            "type": "dart",
            "deviceId": "chrome",
            "args": [
                "--web-port",
                "8080"
            ]
        },
        {
            "name": "caseya (Web Server - localhost:8080)",
            "request": "launch",
            "type": "dart",
            "deviceId": "web-server",
            "args": [
                "--web-port",
                "8080",
                "--web-hostname",
                "localhost"
            ]
        },
        {
            "name": "caseya (Windows Desktop)",
            "request": "launch",
            "type": "dart",
            "deviceId": "windows"
        }
    ]
}