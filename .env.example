# =============================================================================
# CASEYA DAIRY PLANT ERP — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# IMPORTANT: Never commit actual secret keys or .env files to GitHub.
# Pass these variables via --dart-define during build time or in Vercel.
#
# Example Flutter Web build command:
# flutter build web --release \
#   --dart-define=SUPABASE_URL=https://your-project-ref.supabase.co \
#   --dart-define=SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsIn... \
#   --dart-define=API_BASE_URL=https://api.caseya-plant.com/api/v1
# =============================================================================

# --- 1. Supabase Cloud Project Settings ---
# Project URL found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co

# Public/Anon API Key (Safe for browser client)
# Found in Supabase Dashboard -> Project Settings -> API -> Project API Keys
SUPABASE_ANON_KEY=your-anon-or-publishable-key-here
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key-here

# --- 2. Plant Configuration ---
PLANT_NAME=Central Dairy Processing Facility
ENVIRONMENT=production

# --- 3. Optional Legacy FastAPI Backend URL ---
API_BASE_URL=http://localhost:8000/api/v1
